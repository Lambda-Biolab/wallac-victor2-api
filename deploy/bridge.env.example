# Wallac Bridge environment file.
# Copy to /etc/wallac-bridge/bridge.env and fill in real values.
# DO NOT commit this file with real secrets.

# eLabFTW API (dedicated bridge key, NOT a human admin key)
WALLAC_ELABFTW_URL=https://localhost:3148
WALLAC_ELABFTW_API_KEY=
# Runtime environment defaults to production and rejects TLS disablement.
# Existing self-signed deployments must install a CA bundle and keep verification
# enabled, or explicitly set WALLAC_ENV=dev during a temporary migration.
#WALLAC_ENV=production
# Optional PEM CA bundle, preserving system trust plus this CA.
#WALLAC_ELABFTW_CA_BUNDLE=/etc/wallac-bridge/elabftw-ca-bundle.pem
# Verify eLabFTW TLS certificate. Default: 1 (verify on).
# Set to 0 ONLY for local/dev/test diagnostics, never with a CA bundle.
#WALLAC_ELABFTW_VERIFY_TLS=0

# vm-agent REST API (Windows 7 VM on libvirt NAT)
WALLAC_VM_AGENT_URL=http://192.168.122.203:8420
WALLAC_VM_AGENT_TOKEN=

# Bridge HTTP API token (empty = open on LAN)
WALLAC_BRIDGE_TOKEN=

# Designer HTTP API token (empty = open on LAN)
# The Run Builder currently reuses this token for bridge requests, so set both
# token values identically when using the browser UI with authentication.
WALLAC_DESIGNER_TOKEN=

# Browser-reachable bridge URL returned by the designer's /config endpoint.
WALLAC_BRIDGE_URL=

# Validate jobs without starting an instrument run.
#WALLAC_DRY_RUN=1

# CORS allowlist for the bridge API (comma-separated origins).
# Required for browser/Run Builder deployments — must list the exact Run Builder
# origin (the designer at :8422 sends cross-origin requests to the bridge at
# :8423). Empty = no Access-Control-Allow-Origin header (browser blocks the UI).
# Avoid "*" in production.
#WALLAC_CORS_ORIGINS=http://localhost:8422

# Strict-auth mode. When 1/true/yes, the bridge/designer
# services refuse to start with empty bearer tokens. Use this if the
# deployment boundary cannot be trusted.
#WALLAC_REQUIRE_AUTH=1
